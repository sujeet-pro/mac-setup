[user]
    name = Sujeet Jaiswal
    # Email is configured locally in ~/.gitconfig.local

[init]
    defaultBranch = main

[core]
    excludesfile = ~/.config/git/ignore
    editor = zed --wait
    pager = delta
    autocrlf = input
    fsmonitor = true
    untrackedCache = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = simple

[fetch]
    prune = true
    pruneTags = true
    writeCommitGraph = true

[gc]
    writeCommitGraph = true

[diff]
    algorithm = histogram
    colorMoved = default
    renames = true

[merge]
    conflictstyle = zdiff3

[rerere]
    enabled = true
    autoupdate = true

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[column]
    ui = auto

[help]
    autocorrect = prompt

[include]
    path = ~/.gitconfig.local
